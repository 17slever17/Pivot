    if 'describe("ClientSettings display language"' not in text:
        text = replace_once(
            text,
            'describe("ClientSettings word wrap", () => {\n',
            test_block + 'describe("ClientSettings word wrap", () => {\n',
            "settings.test.ts: display language tests",
        )
    save(rel, text)


def add_i18n_files(repo: Path) -> None:
    for rel, content in [
        ("apps/web/src/i18n.ts", I18N_TS),
        ("apps/web/src/i18n.test.ts", I18N_TEST_TS),
    ]:
        path = repo / rel
        if path.exists():
            current = read(path)
            marker = '"settings.language.russian"' if rel.endswith("i18n.ts") else 'describe("i18n"'
            if marker not in current:
                raise PatchError(f"Refusing to overwrite unrelated existing file: {path}")
            STAGED[rel] = current
        else:
            NEW_FILES[rel] = content


