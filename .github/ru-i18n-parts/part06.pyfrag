        '          <h3 className="font-medium text-foreground text-sm">{t("rightPanel.openSurface")}</h3>\n'
        '          <p className="mt-1 text-muted-foreground text-xs">\n'
        '            {t("rightPanel.chooseSurface")}\n'
        '          </p>\n',
        "RightPanelTabs.tsx: launcher heading",
    )
    # Menu labels on non-empty panels. Technical Diff/Pull request remain unchanged via catalog.
    text = replace_once(
        text,
        'export function RightPanelTabs(props: RightPanelTabsProps) {\n',
        'export function RightPanelTabs(props: RightPanelTabsProps) {\n'
        '  const { t } = useTranslation();\n',
        "RightPanelTabs.tsx: main hook",
    )
    for old, new, label in [
        ('                  aria-label="Add panel surface"\n',
         '                  aria-label={t("rightPanel.addSurface")}\n',
         "add surface aria"),
        ('                    Browser\n',
         '                    {t("rightPanel.browser")}\n',
