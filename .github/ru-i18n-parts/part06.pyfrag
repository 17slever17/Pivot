         "PR menu"),
        ('                    Agents\n',
         '                    {t("rightPanel.agents")}\n',
         "agents menu"),
    ]:
        text = replace_once(text, old, new, f"RightPanelTabs.tsx: {label}")
    save(rel, text)


def commit_files(repo: Path) -> list[str]:
    changed: list[str] = []
    for rel, content in STAGED.items():
        path = repo / rel
        old = read(path)
        if old != content:
            path.write_text(content, encoding="utf-8", newline="\n")
            changed.append(rel)
    for rel, content in NEW_FILES.items():
        path = repo / rel
        if path.exists():
            current = read(path)
            if current != content:
                raise PatchError(f"Refusing to overwrite existing file after staging: {path}")
            continue
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(content, encoding="utf-8", newline="\n")
        changed.append(rel)
    return changed


def diff_check(repo: Path) -> tuple[int, str]:
    proc = subprocess.run(
        ["git", "-C", str(repo), "diff", "--check"],
        capture_output=True,
        text=True,
        encoding="utf-8",
        errors="replace",
    )
    return proc.returncode, (proc.stdout + proc.stderr).strip()


