        "RightPanelTabs.tsx: empty state hook",
    )
    action_replacements = [
        ('      label: "Browser",\n      description: "Open a local app or URL.",',
         '      label: t("rightPanel.browser"),\n      description: t("rightPanel.openBrowser"),'),
        ('      label: "Terminal",\n      description: "Start a shell in this workspace.",',
         '      label: t("rightPanel.terminal"),\n      description: t("rightPanel.openTerminal"),'),
        ('      label: "Files",\n      description: "Browse and read workspace files.",',
         '      label: t("rightPanel.files"),\n      description: t("rightPanel.openFiles"),'),
        ('      label: "Diff",\n      description: "Review changes in this thread.",',
