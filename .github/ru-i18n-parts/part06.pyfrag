         '                                  project: project.displayName,\n'
         '                                })}\n',
         "project settings"),
        ('                          aria-label="New project"\n',
         '                          aria-label={t("sidebar.newProject")}\n',
         "new project aria"),
        ('                    <TooltipPopup side="right">New project</TooltipPopup>\n',
         '                    <TooltipPopup side="right">{t("sidebar.newProject")}</TooltipPopup>\n',
         "new project tooltip"),
        ('                  aria-label="Thread search results"\n',
         '                  aria-label={t("sidebar.searchResults")}\n',
         "search results aria"),
        ('                No threads found\n',
         '                {t("sidebar.noSearchResults")}\n',
         "no search results"),
        ('                                {snoozedShelfExpanded\n'
         '                                  ? "Snoozed"\n'
         '                                  : `Snoozed (${snoozedThreads.length})`}\n',
         '                                {snoozedShelfExpanded\n'
         '                                  ? t("sidebar.snoozed")\n'
         '                                  : `${t("sidebar.snoozed")} (${snoozedThreads.length})`}\n',
         "snoozed shelf"),
        ('                  <span>No projects yet</span>\n',
         '                  <span>{t("sidebar.noProjects")}</span>\n',
         "no projects"),
        ('                    Add project\n',
         '                    {t("sidebar.addProject")}\n',
         "add project"),
        ('                `No threads in ${scopedProjectGroup.displayName} yet`\n',
         '                t("sidebar.noThreadsInProject", { project: scopedProjectGroup.displayName })\n',
         "no threads in project"),
        ('                "No threads yet"\n',
         '                t("sidebar.noThreads")\n',
         "no threads"),
    ]
    for old, new, label in replacements:
        text = replace_once(text, old, new, f"Sidebar.tsx: {label}")
    save(rel, text)


def patch_settled_dock(repo: Path) -> None:
    rel = "apps/web/src/components/sidebar/SidebarSettledDock.tsx"
    text = load(repo, rel)
    text = add_import(
        text,
        'import { TooltipProvider } from "../ui/tooltip";\n',
        'import { useTranslation } from "../../i18n";\n',
        "SidebarSettledDock.tsx: i18n import",
    )
    text = replace_once(
        text,
        'export function SidebarSettledDock(props: SidebarSettledDockProps) {\n'
        '  return (\n',
        'export function SidebarSettledDock(props: SidebarSettledDockProps) {\n'
        '  const { t } = useTranslation();\n'
        '  return (\n',
        "SidebarSettledDock.tsx: hook",
    )
    text = replace_once(
        text,
        '          {props.expanded ? "Settled" : `Settled (${props.settled.length})`}\n',
        '          {props.expanded\n'
        '            ? t("sidebar.settled")\n'
        '            : `${t("sidebar.settled")} (${props.settled.length})`}\n',
        "SidebarSettledDock.tsx: label",
    )
    text = replace_once(
        text,
        '              Show {Math.min(props.hiddenCount, SETTLED_DOCK_PAGE_COUNT)} more\n',
        '              {t("sidebar.showMore", {\n'
        '                count: Math.min(props.hiddenCount, SETTLED_DOCK_PAGE_COUNT),\n'
        '              })}\n',
        "SidebarSettledDock.tsx: show more",
    )
    save(rel, text)


