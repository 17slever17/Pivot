        ('      label: "Agents",\n      description: "Follow subagents and workflows.",',
         '      label: t("rightPanel.agents"),\n      description: t("rightPanel.openAgents"),'),
    ]
    for idx, (old, new) in enumerate(action_replacements, start=1):
        text = replace_once(text, old, new, f"RightPanelTabs.tsx: action {idx}")
    text = replace_once(
        text,
        '      aria-label="Open a surface"\n',
