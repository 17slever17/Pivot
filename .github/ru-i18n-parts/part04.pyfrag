  "/settings/general": "settings.general",
  "/settings/appearance": "settings.appearance",
  "/settings/notifications": "settings.notifications",
  "/settings/keybindings": "settings.keybindings",
  "/settings/providers": "settings.providers",
  "/settings/source-control": "settings.sourceControl",
  "/settings/connections": "settings.connections",
  "/settings/archived": "settings.archive",
};

'''
    text = replace_once(
        text,
        'const SETTINGS_SECTION_ICONS: Readonly<\n',
        mapping + 'const SETTINGS_SECTION_ICONS: Readonly<\n',
        "SettingsSidebarNav.tsx: translation map",
    )
    text = replace_once(
        text,
        'export function SettingsSidebarNav({ pathname }: { pathname: string }) {\n'
        '  const navigate = useNavigate();\n',
        'export function SettingsSidebarNav({ pathname }: { pathname: string }) {\n'
        '  const { t } = useTranslation();\n'
        '  const navigate = useNavigate();\n',
        "SettingsSidebarNav.tsx: hook",
    )
    for old, new, label in [
        ('              placeholder="Search"\n',
         '              placeholder={t("settings.search")}\n',
         "search placeholder"),
        ('              aria-label="Search settings"\n',
         '              aria-label={t("settings.searchAria")}\n',
         "search aria"),
        ('                aria-label="Clear settings search"\n',
         '                aria-label={t("settings.clearSearch")}\n',
         "clear search"),
        ('              No settings found\n',
         '              {t("settings.noResults")}\n',
         "no results"),
        ('            aria-label={isSearching && hasResults ? "Settings search results" : undefined}\n',
         '            aria-label={isSearching && hasResults ? t("settings.searchResults") : undefined}\n',
         "results aria"),
        ('                          {SETTINGS_SECTION_LABELS[item.to]}\n',
         '                          {t(SETTINGS_SECTION_TRANSLATION_KEYS[item.to])}\n',
         "result section"),
        ('                        <span className="truncate">{item.label}</span>\n',
         '                        <span className="truncate">\n'
         '                          {t(SETTINGS_SECTION_TRANSLATION_KEYS[item.to])}\n'
         '                        </span>\n',
         "nav item"),
        ('                <span>Back</span>\n',
         '                <span>{t("nav.back")}</span>\n',
         "back"),
    ]:
        text = replace_once(text, old, new, f"SettingsSidebarNav.tsx: {label}")
    save(rel, text)


