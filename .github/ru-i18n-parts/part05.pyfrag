def patch_omp_login(repo: Path) -> None:
    rel = "apps/web/src/components/settings/OmpLoginSection.tsx"
    text = load(repo, rel)
    text = add_import(
        text,
        'import { stackedThreadToast, toastManager } from "../ui/toast";\n',
        'import { useTranslation } from "../../i18n";\n',
        "OmpLoginSection.tsx: i18n import",
    )
    text = replace_once(
        text,
        '}) {\n'
        '  const listLoginProviders = useAtomCommand(serverEnvironment.ompListLoginProviders, {\n',
        '}) {\n'
        '  const { t } = useTranslation();\n'
        '  const listLoginProviders = useAtomCommand(serverEnvironment.ompListLoginProviders, {\n',
        "OmpLoginSection.tsx: hook",
    )
    replacements = [
        ('          title: "Could not load omp login providers",\n',
         '          title: t("omp.loadFailed"),\n',
         "load failure title"),
        ('          description: "Check that omp is installed and try again.",\n',
         '          description: t("omp.checkInstalled"),\n',
         "load failure description"),
        ('          title: `Login failed for ${providerId}`,\n',
         '          title: t("omp.loginFailed", { provider: providerId }),\n',
         "login failure title"),
        ('            "Complete login in the browser opened on the server host, or run omp login there.",\n',
         '            t("omp.loginFailedDescription"),\n',
         "login failure description"),
        ('      title: `Signed in to ${providerId}`,\n',
         '      title: t("omp.signedInTo", { provider: providerId }),\n',
         "login success"),
        ('        <span className="text-xs font-medium text-foreground">omp accounts</span>\n',
         '        <span className="text-xs font-medium text-foreground">{t("omp.accounts")}</span>\n',
         "accounts heading"),
        ('          Refresh\n',
         '          {t("omp.refresh")}\n',
         "refresh"),
        ('        Login opens in a browser on the machine running the T3 server. OAuth callbacks stay on that\n'
         '        host.\n',
         '        {t("omp.loginDescription")}\n',
         "description"),
        ('          Loading login providers…\n',
         '          {t("omp.loadingProviders")}\n',
         "loading"),
        ('        <p className="text-xs text-muted-foreground">No login providers reported by omp.</p>\n',
         '        <p className="text-xs text-muted-foreground">{t("omp.noProviders")}</p>\n',
         "no providers"),
        ('                  {provider.authenticated ? "Signed in" : "Not signed in"}\n'
         '                  {provider.available ? "" : " · unavailable"}\n',
         '                  {provider.authenticated ? t("omp.signedIn") : t("omp.notSignedIn")}\n'
         '                  {provider.available ? "" : ` · ${t("omp.unavailable")}`}\n',
         "status"),
        ('                  "Re-login"\n',
         '                  t("omp.relogin")\n',
         "relogin"),
        ('                  "Login"\n',
         '                  t("omp.login")\n',
         "login"),
    ]
    for old, new, label in replacements:
        text = replace_once(text, old, new, f"OmpLoginSection.tsx: {label}")
    save(rel, text)


